{
  "name": "IntegrationWebhook",
  "type": "object",
  "properties": {
    "integration_slug": {
      "type": "string",
      "description": "Slug da integra\u00e7\u00e3o (ex: zapsign, clicksign, evolution-api)"
    },
    "event_type": {
      "type": "string",
      "description": "Tipo do evento recebido"
    },
    "payload": {
      "type": "object",
      "description": "Payload completo do webhook"
    },
    "processed": {
      "type": "boolean",
      "default": false,
      "description": "Se o webhook foi processado"
    }
  },
  "required": [
    "integration_slug",
    "payload"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}