{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "Papel do usu\u00e1rio no sistema",
      "enum": [
        "admin",
        "gerente",
        "vendedor",
        "revendedor",
        "parceiro"
      ],
      "default": "vendedor"
    },
    "equipe": {
      "type": "string",
      "description": "Nome da equipe ou grupo (para gerentes agruparem vendedores)"
    },
    "gerente_id": {
      "type": "string",
      "description": "ID do gerente respons\u00e1vel (para vendedores)"
    },
    "gerente_nome": {
      "type": "string",
      "description": "Nome do gerente respons\u00e1vel"
    },
    "telefone": {
      "type": "string",
      "description": "WhatsApp do usu\u00e1rio (somente d\u00edgitos com DDI: 55+DDD+n\u00famero)"
    },
    "id_vendedor_ixc": {
      "type": "string",
      "description": "ID do vendedor no IXCSoft (v\u00ednculo para envio correto em cadastros)"
    },
    "nome_vendedor_ixc": {
      "type": "string",
      "description": "Nome do vendedor no IXCSoft (para confer\u00eancia)"
    },
    "parceiro_codigo": {
      "type": "string",
      "description": "C\u00f3digo de parceiro \u00fanico (usado no link /assinar?v=...)"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o usu\u00e1rio est\u00e1 ativo"
    }
  },
  "required": [
    "role"
  ]
}