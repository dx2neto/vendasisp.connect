{
  "name": "Integration",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "description": "Identificador \u00fanico (ex: zapsign, omie, ixcsoft, evolution-api, openai, claude, clicksign, pagcard)"
    },
    "display_name": {
      "type": "string",
      "description": "Nome amig\u00e1vel (ex: ZapSign)"
    },
    "description": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "default": false,
      "description": "Se a integra\u00e7\u00e3o est\u00e1 ativa"
    },
    "environment": {
      "type": "string",
      "enum": [
        "production",
        "sandbox"
      ],
      "default": "production"
    },
    "base_url": {
      "type": "string",
      "description": "URL base da API (edit\u00e1vel no painel)"
    },
    "extra_config": {
      "type": "object",
      "description": "Configura\u00e7\u00f5es adicionais n\u00e3o sens\u00edveis (ex: anthropic_version, paths do PagCard)"
    },
    "category": {
      "type": "string",
      "enum": [
        "signature",
        "erp",
        "whatsapp",
        "ai",
        "payment"
      ],
      "description": "Categoria da integra\u00e7\u00e3o"
    },
    "secrets_required": {
      "type": "array",
      "description": "Lista de nomes de secrets necess\u00e1rios",
      "items": {
        "type": "string"
      }
    },
    "has_webhook": {
      "type": "boolean",
      "default": false,
      "description": "Se recebe webhooks"
    }
  },
  "required": [
    "slug",
    "display_name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}