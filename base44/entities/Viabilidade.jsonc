{
  "name": "Viabilidade",
  "type": "object",
  "properties": {
    "pedido_id": {
      "type": "string"
    },
    "endereco": {
      "type": "string"
    },
    "resultado": {
      "type": "string",
      "enum": [
        "viavel",
        "inviavel",
        "parcial"
      ],
      "default": "viavel"
    },
    "tecnologia": {
      "type": "string"
    },
    "observacao": {
      "type": "string"
    }
  },
  "required": [
    "pedido_id"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}