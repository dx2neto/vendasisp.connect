{
  "name": "LGPDConsentimento",
  "type": "object",
  "properties": {
    "lead_id": {
      "type": "string",
      "description": "ID do lead/cliente"
    },
    "lead_nome": {
      "type": "string"
    },
    "lead_documento": {
      "type": "string",
      "description": "CPF/CNPJ (mascarado)"
    },
    "consent_type": {
      "type": "string",
      "enum": [
        "coleta_dados",
        "marketing",
        "terceiros",
        "credit_check",
        "contrato"
      ],
      "description": "Tipo de consentimento"
    },
    "consent_given": {
      "type": "boolean",
      "default": false,
      "description": "Se o consentimento foi concedido"
    },
    "consent_date": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do consentimento"
    },
    "consent_text": {
      "type": "string",
      "description": "Texto exibido ao usu\u00e1rio"
    },
    "withdrawal_date": {
      "type": "string",
      "format": "date-time",
      "description": "Data de retirada do consentimento (se aplic\u00e1vel)"
    },
    "ip_address": {
      "type": "string"
    },
    "user_agent": {
      "type": "string"
    },
    "data_retention_days": {
      "type": "number",
      "default": 1095,
      "description": "Prazo de reten\u00e7\u00e3o em dias (padr\u00e3o 3 anos)"
    },
    "anonymized": {
      "type": "boolean",
      "default": false,
      "description": "Se os dados foram anonimizados"
    }
  },
  "required": [
    "consent_type",
    "consent_given"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}