{
  "name": "Contato",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string"
    },
    "telefone": {
      "type": "string",
      "description": "Somente d\u00edgitos com DDI, ex: 5534999990000"
    },
    "push_name": {
      "type": "string"
    },
    "ixc_id": {
      "type": "string",
      "description": "ID do cliente no IXC"
    }
  },
  "required": [
    "telefone"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}